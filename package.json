{
  "name": "noblog",
  "version": "0.2.3",
  "description": "Generate static blog content from a Notion.so table.",
  "author": "humbornjo",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "noblog": "dist/generate.js"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "nodejs",
    "notion",
    "blog"
  ],
  "homepage": "https://github.com/humbornjo/noblog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humbornjo/noblog.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:built": "pnpm run build && node scripts/smoke.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:built && publint",
    "prepack": "pnpm run build",
    "release": "pnpm run check && npm publish",
    "release:beta": "pnpm run check && pnpm publish --tag beta"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "@stricli/core": "^1.3.0",
    "dotenv": "^16.6.1",
    "markdown-table": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "publint": "^0.3.25",
    "tsdown": "0.22.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
