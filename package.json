{
  "name": "noblog",
  "version": "0.2.0-beta",
  "description": "Generate static blog content from a Notion.so table.",
  "author": "humbornjo",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "noblog": "dist/generate.js"
  },
  "files": [
    "dist/",
    "assets/"
  ],
  "keywords": [
    "nodejs",
    "notion",
    "blog"
  ],
  "homepage": "https://github.com/humbornjo/noblog",
  "repository": {
    "type": "git",
    "url": "https://github.com/humbornjo/noblog.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc && node ./dist/index.js",
    "build": "pnpm run build:module",
    "build:module": "rm -rf dist && rollup -c && tsc --emitDeclarationOnly",
    "release": "pnpm run build && npm publish",
    "release:beta": "pnpm run build && pnpm publish --tag beta",
    "upgrade": "node tools/upgrade-deps.js"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "@types/async-retry": "^1.4.9",
    "async-retry": "^1.3.3",
    "dotenv": "^16.6.1",
    "markdown-table": "^3.0.4",
    "node-fetch": "^3.3.2",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^24.6.2",
    "tslib": "^2.8.1"
  }
}
